# ImmoFugger — Umgebungsvariablen
#
# Kopiere diese Datei zu ".env" und trage deine Supabase-Zugangsdaten ein.
# Findest du im Supabase-Dashboard unter: Project Settings → API.
#
# Solange diese Werte fehlen, läuft die App automatisch im Demo-Modus
# (localStorage) — du kannst also sofort alles testen.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
