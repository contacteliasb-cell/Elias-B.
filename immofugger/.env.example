# ImmoFugger — Umgebungsvariablen
# Kopiere diese Datei zu `.env` und trage deine Supabase-Werte ein.
# Ohne diese Werte läuft die App automatisch im Demo-Modus (localStorage).
#
# Beide Werte findest du im Supabase-Dashboard unter:
# Project Settings → API  (siehe README, Abschnitt „Supabase in 10 Minuten")

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
